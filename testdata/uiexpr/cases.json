[
  { "expr": "1 + 2 * 3", "want": 7 },
  { "expr": "(1 + 2) * 3", "want": 9 },
  { "expr": "7 % 3", "want": 1 },
  { "expr": "1 / 2", "want": 0.5 },
  { "expr": "-3 + 1", "want": -2 },
  { "expr": "2.5 * 2", "want": 5 },
  { "expr": "1 == 1.0", "want": true },
  { "expr": "'a' + 'b'", "want": "ab" },
  { "expr": "\"double\" + 'single'", "want": "doublesingle" },
  { "expr": "'it\\'s'", "want": "it's" },
  { "expr": "'a' < 'b'", "want": true },
  { "expr": "3 >= 3 && 2 > 3", "want": false },
  { "expr": "true || false", "want": true },
  { "expr": "true and not false", "want": true },
  { "expr": "!true", "want": false },
  { "expr": "true ? 'y' : 'n'", "want": "y" },
  { "expr": "1 > 2 ? 'a' : 2 > 1 ? 'b' : 'c'", "want": "b" },
  { "expr": "nil ?? 'd'", "want": "d" },
  { "expr": "x ?? 'd'", "env": { "x": "v" }, "want": "v" },
  { "expr": "m.missing ?? 0", "env": { "m": {} }, "want": 0 },
  { "expr": "nil == nil", "want": true },
  { "expr": "m.a == nil", "env": { "m": { "b": 1 } }, "want": true },
  { "expr": "m.a != nil", "env": { "m": { "a": "x" } }, "want": true },
  { "expr": "m.a.b", "env": { "m": { "a": { "b": 3 } } }, "want": 3 },
  { "expr": "m['a']", "env": { "m": { "a": 4 } }, "want": 4 },
  { "expr": "m?.a", "env": { "m": null }, "want": null },
  { "expr": "l[0]", "env": { "l": [ "x", "y" ] }, "want": "x" },
  { "expr": "l[-1]", "env": { "l": [ "x", "y" ] }, "want": "y" },
  { "expr": "'x' in ['x', 'y']", "want": true },
  { "expr": "'z' in l", "env": { "l": [ "x" ] }, "want": false },
  { "expr": "'k' in {'k': 1}", "want": true },
  { "expr": "'admin' in p.roles", "env": { "p": { "roles": [ "admin" ] } }, "want": true },
  { "expr": "'hello' contains 'ell'", "want": true },
  { "expr": "'hello' startsWith 'he'", "want": true },
  { "expr": "'hello' endsWith 'lo'", "want": true },
  { "expr": "len('abc')", "want": 3 },
  { "expr": "len([1, 2])", "want": 2 },
  { "expr": "len({'a': 1})", "want": 1 },
  { "expr": "lower('AbC')", "want": "abc" },
  { "expr": "upper('abc')", "want": "ABC" },
  { "expr": "trim('  x ')", "want": "x" },
  { "expr": "string(2)", "want": "2" },
  { "expr": "string(1.5)", "want": "1.5" },
  { "expr": "string(true)", "want": "true" },
  { "expr": "int('42')", "want": 42 },
  { "expr": "int(2.7)", "want": 2 },
  { "expr": "float('2.5')", "want": 2.5 },
  { "expr": "join(['a', 'b'], ', ')", "want": "a, b" },
  { "expr": "split('a,b', ',')", "want": [ "a", "b" ] },
  { "expr": "abs(-2)", "want": 2 },
  { "expr": "round(2.5)", "want": 3 },
  { "expr": "round(-2.5)", "want": -3 },
  { "expr": "floor(2.7)", "want": 2 },
  { "expr": "ceil(2.1)", "want": 3 },
  { "expr": "min(3, 1, 2)", "want": 1 },
  { "expr": "max(3, 1, 2)", "want": 3 },
  { "expr": "[1, 'a', nil]", "want": [ 1, "a", null ] },
  { "expr": "{'a': 1 + 1}", "want": { "a": 2 } },
  { "expr": "string(n.done ?? 0) + ' / ' + string(n.total)", "env": { "n": { "total": 4 } }, "want": "0 / 4" },
  { "expr": "x | upper()", "env": { "x": "a" }, "reject": true },
  { "expr": "filter([1, 2], # > 1)", "reject": true },
  { "expr": "let x = 1; x", "reject": true },
  { "expr": "'a' matches 'a'", "reject": true },
  { "expr": "1..3", "reject": true },
  { "expr": "2 ** 3", "reject": true },
  { "expr": "l[0:1]", "env": { "l": [ 1 ] }, "reject": true },
  { "expr": "`raw`", "reject": true },
  { "expr": "hasRole(x, 'a')", "reject": true },
  { "expr": "toJSON(1)", "reject": true }
]
