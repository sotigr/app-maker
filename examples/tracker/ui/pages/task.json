{
  "page": "task",
  "title": "{{ data.task.title }}",
  "route": "/tasks/:id",
  "params": { "id": { "type": "string", "format": "uuid" } },
  "data": {
    "task": { "feature": "params.id", "type": "task" },
    "project": { "feature": "data.task.parentId", "type": "project" },
    "comments": { "children": "params.id", "type": "comment" }
  },
  "body": { "component": "stack", "gap": "lg", "children": [
    { "component": "link", "text": "← {{ data.project.title }}", "page": "project", "params": { "id": "data.task.parentId" } },
    { "component": "row", "justify": "between", "children": [
      { "component": "heading", "text": "{{ data.task.title }}", "level": 1 },
      { "component": "row", "children": [
        { "component": "transitions", "source": "task" },
        { "component": "menu", "label": "More", "items": [
          { "label": "Triage", "visible": "can(data.task, 'action:triage')",
            "steps": [ { "do": "action", "type": "task", "id": "params.id", "action": "triage" },
                       { "do": "toast", "text": "Labelled {{ result.output.label }}" } ] },
          { "label": "Delete", "visible": "can(data.task, 'delete')",
            "steps": [ { "do": "delete", "type": "task", "id": "params.id", "confirm": "Delete {{ data.task.title }}?" },
                       { "do": "navigate", "page": "project", "params": { "id": "data.task.parentId" } } ] }
        ] }
      ] }
    ] },
    { "component": "columns", "children": [
      { "component": "stack", "children": [
        { "component": "detail", "source": "task", "fields": ["/status", "/assignee", "/dueAt", "/estimate", "/label", "/isLate", "/attachment"] },
        { "component": "link", "text": "Download attachment ({{ formatNumber(ceil(data.task.attachment.size / 1024), 0) }} KB)",
          "visible": "data.task.attachment != nil", "url": "{{ data.task.attachment.url }}",
          "download": "{{ data.task.title }}{{ data.task.attachment.contentType == 'application/pdf' ? '.pdf' : data.task.attachment.contentType == 'text/plain' ? '.txt' : '.' + split(data.task.attachment.contentType, '/')[1] }}" }
      ] },
      { "component": "card", "title": "Edit", "visible": "can(data.task, 'update')", "children": [
        { "component": "form", "mode": "update", "type": "task", "id": "params.id", "submit": "Save",
          "fields": [ { "path": "/title" }, { "path": "/assignee", "widget": "ref", "labelField": "displayName" }, { "path": "/dueAt" },
                      { "path": "/estimate" }, { "path": "/attachment" } ],
          "on": { "submit": [ { "do": "toast", "text": "Saved", "tone": "success" } ] } }
      ] }
    ] },
    { "component": "card", "title": "Comments", "children": [
      { "component": "list", "source": "comments", "empty": "No comments yet.",
        "item": { "component": "stack", "gap": "none", "children": [
          { "component": "markdown", "text": "{{ item.body }}" },
          { "component": "field", "path": "/createdAt", "display": "datetime" }
        ] } },
      { "component": "form", "mode": "create", "type": "comment", "parent": "params.id", "submit": "Comment",
        "visible": "can(data.task, 'create:comment')", "fields": [ { "path": "/body", "widget": "textarea", "label": "Add a comment" } ] }
    ] }
  ] }
}
