{
  "$id": "urn:app:feature:project/v1/views/admin.query",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "createdAt": {
      "format": "date-time",
      "readOnly": true,
      "type": "string"
    },
    "owner": {
      "format": "uuid",
      "type": "string"
    },
    "slug": {
      "maxLength": 80,
      "pattern": "^[a-z0-9-]+$",
      "type": "string"
    },
    "title": {
      "maxLength": 200,
      "type": "string"
    },
    "updatedAt": {
      "format": "date-time",
      "readOnly": true,
      "type": "string"
    }
  },
  "title": "Project",
  "type": "object"
}
