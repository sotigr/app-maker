{
  "$id": "urn:app:feature:project/v1/views/admin.read",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "createdAt": {
      "format": "date-time",
      "readOnly": true,
      "type": "string"
    },
    "description": {
      "maxLength": 5000,
      "type": "string"
    },
    "doneCount": {
      "type": "integer"
    },
    "notes": {
      "description": "Owner-only notes",
      "maxLength": 5000,
      "type": "string"
    },
    "owner": {
      "format": "uuid",
      "type": "string"
    },
    "presence": {
      "description": "Who is looking at the project right now (ephemeral)",
      "maxLength": 200,
      "type": "string"
    },
    "slug": {
      "maxLength": 80,
      "pattern": "^[a-z0-9-]+$",
      "type": "string"
    },
    "summary": {
      "description": "Model-written status summary (summarize action)",
      "maxLength": 2000,
      "type": "string"
    },
    "summaryDraft": {
      "description": "Summary text while it is being generated (ephemeral)",
      "maxLength": 5000,
      "type": "string"
    },
    "taskCount": {
      "type": "integer"
    },
    "title": {
      "maxLength": 200,
      "type": "string"
    },
    "updatedAt": {
      "format": "date-time",
      "readOnly": true,
      "type": "string"
    }
  },
  "required": [
    "title"
  ],
  "title": "Project",
  "type": "object"
}
