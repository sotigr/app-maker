{
  "$id": "urn:app:feature:task/v2/views/owner.update",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assignee": {
      "format": "uuid",
      "type": [
        "string",
        "null"
      ]
    },
    "dueAt": {
      "format": "date-time",
      "type": "string"
    },
    "estimate": {
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
      "type": "string"
    },
    "label": {
      "description": "Set by the triage action (Python code node)",
      "enum": [
        "bug",
        "feature",
        "chore"
      ]
    },
    "progress": {
      "maximum": 100,
      "minimum": 0,
      "type": "integer"
    },
    "title": {
      "maxLength": 200,
      "type": "string"
    }
  },
  "title": "Task",
  "type": "object"
}
