{
  "$id": "urn:app:feature:project/v1/views/public.create",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "description": {
      "maxLength": 5000,
      "type": "string"
    },
    "slug": {
      "maxLength": 80,
      "pattern": "^[a-z0-9-]+$",
      "type": "string"
    },
    "title": {
      "maxLength": 200,
      "type": "string"
    }
  },
  "required": [
    "title"
  ],
  "title": "Project",
  "type": "object"
}
