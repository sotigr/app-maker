{
  "$id": "urn:app:feature:task/v2/views/admin.event",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assignee": {
      "format": "uuid",
      "type": [
        "string",
        "null"
      ]
    },
    "attachment": {
      "additionalProperties": false,
      "description": "A file attached to the task (uploaded through POST /v1/uploads)",
      "properties": {
        "contentType": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "size",
        "contentType"
      ],
      "type": "object"
    },
    "createdAt": {
      "format": "date-time",
      "readOnly": true,
      "type": "string"
    },
    "dueAt": {
      "format": "date-time",
      "type": "string"
    },
    "estimate": {
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
      "type": "string"
    },
    "isLate": {
      "readOnly": true,
      "type": "boolean"
    },
    "label": {
      "description": "Set by the triage action (Python code node)",
      "enum": [
        "bug",
        "feature",
        "chore"
      ]
    },
    "number": {
      "title": "Number",
      "type": "string"
    },
    "owner": {
      "format": "uuid",
      "type": "string"
    },
    "progress": {
      "maximum": 100,
      "minimum": 0,
      "type": "integer"
    },
    "status": {
      "default": "todo",
      "enum": [
        "todo",
        "in_progress",
        "done"
      ]
    },
    "title": {
      "maxLength": 200,
      "type": "string"
    },
    "updatedAt": {
      "format": "date-time",
      "readOnly": true,
      "type": "string"
    }
  },
  "title": "Task",
  "type": "object"
}
