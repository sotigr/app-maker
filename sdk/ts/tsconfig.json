{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "noEmit": true,
    "paths": { "@organon/client": ["./client/src/index.ts"], "@organon/react": ["./react/src/index.ts"], "@organon/ui": ["./ui/src/index.ts"] }
  },
  "include": ["client/src", "react/src", "ui/src", "gen", "example"]
}
